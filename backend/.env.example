# AI情报站 环境变量配置
# 复制此文件为 .env 并填入实际值

# 数据库
DATABASE_URL=sqlite:///../data/articles.db

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 定时任务
# 抓取频率：cron表达式，默认为每天早上8点
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# RSS 抓取超时（秒）
FETCH_TIMEOUT=30

# LLM评审配置
LLM_ENABLED=true
LLM_MODEL=qwen3.5:9b
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
